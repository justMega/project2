# ---------------- Python
.venv/
__pycache__/
*.pyc

# ---------------- training (python/train_cnn.py)
# keep runs/cnn (model, plots, reports, exported weights); drop the image
# cache (regenerated from the dataset) and the smoke-test run
runs/*/cache/
runs/smoke/

# ---------------- PC evaluation (pc/shape_client.py)
# results/ and results_newtest/ are kept as evidence for the report
results_check/

# ---------------- Vitis HLS (hls/)
# sources, weights_cstyle_folded/ and tb_data/ are kept: needed to rebuild the IP
hls/ds_cnn_hls/
hls/ds_cnn_prj/
hls/.Xil/
hls/*.log
hls/hls_results.csv

# ---------------- Vivado (vivado/)
# build_cnn_bd.tcl, shape_cnn.xsa and reports/ are kept; the project is
# regenerated by the script
vivado/vivado_cnn/
vivado/.Xil/
vivado/*.jou
vivado/*.log
vivado/*.backup.*

# ---------------- Vitis (vitis_ws/)
# the application source of truth is vitis/main.c; the workspace (platform,
# BSP, builds) is regenerated from shape_cnn.xsa
vitis_ws/

# ---------------- misc
.Xil/
*.str
.DS_Store
