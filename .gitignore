# =====================================================================
#  Assignment 2: CNN vs SNN on PYNQ-Z2
#  Kept in git: sources, trained models, exported weights, build
#  scripts, .xsa, Vivado/HLS reports and the measured results.
#  Ignored: datasets, generated tool projects, caches, logs, local files.
# =====================================================================

# ---------------- course material and local files (not ours to publish)
/Assig 2.pdf
/PYNQ-Z2 v1.0.xdc
/video_assets/
*.zip

# ---------------- datasets (72,000 images, regenerated with
# shapes-dataset/generate_shapes_dataset.py)
shapes-dataset/2D_Geometric_Shapes_Dataset/
2D_Geometric_Shapes_Dataset/
2D_Geometric_Shapes_Dataset_test/

# ---------------- Python
.venv/
__pycache__/
*.pyc

# ---------------- report (LaTeX build files and old drafts)
report/
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# ---------------- evaluation (eval/)
# scripts, RESULTS*.md and the result json/csv files are kept;
# the .npz caches are regenerated by the *_benchmark_sw.py scripts
eval/**/*.npz

# ---------------- CNN training (cnn/python/train_cnn.py)
# runs/cnn (model, plots, reports) is kept; image cache and smoke test are not
cnn/runs/*/cache/
cnn/runs/smoke/

# ---------------- CNN PC evaluation (cnn/pc/shape_client.py)
# results/, results_newtest/ and comparison_newtest/ are kept as evidence
cnn/pc/results_check/
/results/

# ---------------- Vitis HLS (cnn/hls/)
# sources, weights and tb_data are kept: needed to rebuild the IP
cnn/hls/ds_cnn_hls/
cnn/hls/ds_cnn_prj/
cnn/hls/hls_results.csv

# ---------------- Vivado (cnn/vivado/)
# build_cnn_bd.tcl, shape_cnn.xsa and reports/ are kept; the project is
# regenerated by the script
cnn/vivado/vivado_cnn/
cnn/vivado/NA/
*.backup.*

# ---------------- Vitis (cnn/vitis_ws/)
# the application source is cnn/vitis/main.c; the workspace (platform,
# BSP, builds) is regenerated from shape_cnn.xsa
cnn/vitis_ws/

# ---------------- Vivado / Vitis temporary files (any folder)
_ide/
.analyzer_session.json
cnn/hls/.gitignore
.Xil/
*.jou
*.str
*.logfile
vivado_pid*
webtalk*

# ---------------- OS / editors
.DS_Store
.vscode/
.idea/
